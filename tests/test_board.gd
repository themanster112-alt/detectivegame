extends SceneTree
const Session = preload("res://scripts/core/investigation_session.gd")
func _initialize() -> void:
	var s := Session.new()
	assert(s.load_case("res://data/cases/midnight_training.json"))
	assert(s.begin_investigation())
	assert(s.try_inference("phone", "coffee", "return").status == "invalid")
	assert(s.collect_evidence("phone"))
	assert(s.collect_evidence("coffee"))
	assert(s.try_inference("phone", "phone", "return").status == "invalid")
	assert(s.try_inference("phone", "coffee", "debt").status == "hypothesis")
	assert(s.confirmed_inferences().is_empty() and s.hypotheses().size() == 1)
	assert(s.try_inference("coffee", "phone", "return").status == "confirmed")
	assert(s.try_inference("phone", "coffee", "return").status == "duplicate")
	assert(s.confirmed_inferences().size() == 1)
	assert(s.select_person("layla"))
	assert(s.hear_statement(s.person_statements("layla")[0].id))
	assert(s.link_nodes(["p:layla", "s:layla_line_0"], "return").status == "hypothesis")
	assert(s.known_nodes().any(func(item): return item.kind == "statement"))
	assert(s.known_nodes().any(func(item): return item.kind == "report"))
	assert(s.known_nodes().any(func(item): return item.kind == "timeline"))
	s.reset()
	assert(s.confirmed_inferences().is_empty() and s.hypotheses().is_empty())
	print("BOARD: PASS")
	quit()
