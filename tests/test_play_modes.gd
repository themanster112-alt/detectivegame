extends "res://tests/test_player_identity.gd"
const MODE_PROFILE := "res://.godot/modes-test-player.json"
const MODE_SAVE := "res://.godot/modes-test-cases.json"
func create_title() -> void:
	title = Title.new()
	title.profile_path = MODE_PROFILE
	title.save_path = MODE_SAVE
	root.add_child(title)
	await settle()
func mode_capture(name: String) -> void:
	if DisplayServer.get_name() != "headless":
		await create_timer(0.3).timeout
		await RenderingServer.frame_post_draw
		root.get_texture().get_image().save_png("res://.godot/modes-" + name + ".png")
func run() -> void:
	root.size = Vector2i(1280,720)
	for path in [MODE_PROFILE, MODE_SAVE]: DirAccess.remove_absolute(path)
	await create_title()
	await press(title.menu_buttons["لعبة جديدة"])
	check(visible_text(title.body).contains("اختيار نمط اللعب"), "New game opens mode selection")
	fit()
	await mode_capture("selection")
	await press(title.menu_buttons["لعب تعاوني"])
	check(visible_text(title.body).contains("قيد التطوير") and visible_text(title.body).contains("لا تُنشأ غرف"), "Cooperative screen explicitly unavailable")
	check(title.menu_buttons.has("إنشاء غرفة") and title.menu_buttons.has("الانضمام لغرفة"), "Both future room actions are present")
	fit()
	await mode_capture("cooperative")
	for room_action in ["إنشاء غرفة", "الانضمام لغرفة"]:
		await press(title.menu_buttons[room_action])
		check(visible_text(title.body).contains("لا يوجد اتصال شبكي"), "Room action never implies a live connection")
		fit()
		await press(title.menu_buttons["عودة"])
	await press(title.menu_buttons["عودة"])
	await press(title.menu_buttons["لعب فردي"])
	await press(title.menu_buttons["عودة"])
	check(title.menu_buttons.has("لعب فردي"), "Identity back returns to modes")
	await press(title.menu_buttons["عودة"])
	check(title.menu_buttons.has("متابعة"), "Mode back returns to main menu")
	await press(title.menu_buttons["لعبة جديدة"])
	await press(title.menu_buttons["لعب فردي"])
	title.name_input.text = "نور الهاشمي"
	title.submit_identity()
	await settle()
	check(title.profile.data.role == "lead_detective" and title.intro.visible, "Solo uses lead role and preserves story opening")
	await press(title.intro.skip_button)
	title.game.begin_investigation()
	await settle()
	check(title.game.player_identity_label.text == "المحقق: نور الهاشمي" and title.game.player_identity_label.is_visible_in_tree(), "Saved player name visibly labels investigation")
	var viewport := Rect2(Vector2.ZERO, Vector2(1280,720))
	check(viewport.encloses(title.game.player_identity_label.get_global_rect()), "Identity label fits investigation viewport")
	check(not title.game.conclusion_button.disabled, "Adding roles does not restrict solo accusation")
	check(title.game.session.case_snapshot().assistant.name.contains("يزن"), "Yazan remains story assistant")
	title.game.session.collect_evidence("door_events")
	await mode_capture("investigation")
	title.return_to_menu()
	await settle()
	check(visible_text(title.body).contains("نور الهاشمي"), "Saved name is visible on main menu")
	fit()
	await mode_capture("menu")
	var before_profile := FileAccess.get_file_as_string(MODE_PROFILE)
	var before_case := FileAccess.get_file_as_string(MODE_SAVE)
	await press(title.menu_buttons["لعبة جديدة"])
	await press(title.menu_buttons["لعب تعاوني"])
	await press(title.menu_buttons["إنشاء غرفة"])
	await press(title.menu_buttons["عودة"])
	await press(title.menu_buttons["الانضمام لغرفة"])
	await press(title.menu_buttons["عودة"])
	await press(title.menu_buttons["عودة"])
	await press(title.menu_buttons["عودة"])
	check(FileAccess.get_file_as_string(MODE_PROFILE) == before_profile and FileAccess.get_file_as_string(MODE_SAVE) == before_case, "Coop and back navigation leave both saves unchanged")
	await clear_title()
	await create_title()
	check(visible_text(title.body).contains("نور الهاشمي"), "Saved menu name restores on restart")
	await press(title.menu_buttons["متابعة"])
	check(title.game.session.has_evidence("door_events") and not is_instance_valid(title.intro), "Continue restores investigation without replaying intro or resetting state")
	check(title.game.player_identity_label.text.contains("نور الهاشمي"), "Continued investigation restores visible identity")
	for role_id in Profile.ROLES:
		var role: Dictionary = Profile.ROLE_DEFINITIONS[role_id]
		check(role.investigate and role.collect_evidence and role.interrogate, "Both future roles share investigation capabilities")
	check(Profile.ROLE_DEFINITIONS.lead_detective.final_accusation and not Profile.ROLE_DEFINITIONS.assistant_detective.final_accusation, "Final approval policy is prepared as metadata only")
	await clear_title()
	for path in [MODE_PROFILE, MODE_SAVE]: DirAccess.remove_absolute(path)
	print("PLAY MODES: %s (%d checks, %d failures)" % ["PASS" if failures == 0 else "FAIL", checks, failures])
	quit(0 if failures == 0 else 1)
