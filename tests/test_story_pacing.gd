extends "res://tests/test_player_identity.gd"
const STORY_PROFILE := "res://.godot/story-test-player.json"
const STORY_SAVE := "res://.godot/story-test-cases.json"
func create_title() -> void:
	title = Title.new()
	title.profile_path = STORY_PROFILE
	title.save_path = STORY_SAVE
	root.add_child(title)
	await settle()
func story_capture(name: String) -> void:
	await settle()
	if DisplayServer.get_name() != "headless":
		await create_timer(0.3).timeout
		await RenderingServer.frame_post_draw
		root.get_texture().get_image().save_png("res://.godot/story-" + name + ".png")
func finish_batch() -> void:
	for step in range(30):
		if title.intro.next_button.visible: break
		title.intro._process(10.0)
	await settle()
func run() -> void:
	root.size = Vector2i(1280,720)
	for path in [STORY_PROFILE, STORY_SAVE]: DirAccess.remove_absolute(path)
	await create_title()
	await press(title.menu_buttons["لعبة جديدة"])
	await press(title.menu_buttons["لعب فردي"])
	title.name_input.text = "محمد"
	title.submit_identity()
	await settle()
	check(title._opening_background.texture == title.STUDY_BACKGROUND, "Opening uses supplied nighttime study")
	check(title.intro.page == 0 and not title.intro.next_button.visible, "Biography starts automatically without office-item or next buttons")
	check(title.intro._content.find_children("*", "Button", true, false).is_empty(), "No inspection choices interrupt the novel screen")
	var initial: int = title.intro._content.get_child_count()
	var paragraph: Label = title.intro._active_line
	var ratio := paragraph.visible_ratio
	title.intro._process(0.2)
	check(paragraph.visible_ratio > ratio and paragraph.visible_ratio < 1, "Narration actually reveals writing over time")
	await story_capture("novel-biography")
	await finish_batch()
	check(title.intro.page == 1 and title.intro.next_button.text == "الرد على الاتصال", "Phone answer becomes available only after short biography")
	check(title.intro._content.get_child_count() > initial and paragraph.is_inside_tree(), "Previous biography paragraphs remain on the same screen")
	check(visible_text(title.intro).contains("شيرلوك") and visible_text(title.intro).contains("أغاثا") and visible_text(title.intro).contains("سبع سنوات"), "Existing biography facts are presented as prose")
	await story_capture("novel-incoming-call")
	await clear_title()
	await create_title()
	await press(title.menu_buttons["متابعة"])
	check(title.intro.page == 1 and title.intro.next_button.visible, "Saved ringing state restores without changing save schema")
	await press(title.intro.next_button)
	check(title._opening_background.texture == title.CALL_BACKGROUND, "Answering Yazan switches to supplied incoming-call background")
	check(title.intro.page == 2 and not title.intro.next_button.visible, "Answer begins automatic dialogue without question menus")
	check(not visible_text(title.intro).contains("شيرلوك") and not visible_text(title.intro).contains("سبع سنوات"), "Answer clears biography from call screen")
	check(visible_text(title.intro).contains("هل تسمعني"), "Call starts at Yazan first line")
	var heading: Node = title.intro._content.get_child(0)
	var before: int = title.intro._content.get_child_count()
	title.intro._process(10.0)
	title.intro._process(10.0)
	check(title.intro._content.get_child_count() > before and title.intro._content.get_child(0) == heading, "Call lines append under each other without replacing the screen")
	await story_capture("novel-call-in-progress")
	await press(title.intro.log_button)
	var paused: int = title.intro._content.get_child_count()
	title.intro._process(10.0)
	check(title.intro._content.get_child_count() == paused, "Reviewing earlier prose pauses automatic progression")
	await press(title.intro.log_button)
	await finish_batch()
	check(title.intro.page == 3 and title.intro.next_button.visible, "After call a single crime-scene action appears")
	check(visible_text(title.intro).contains("أين سأجدك") and visible_text(title.intro).contains("محمد") and visible_text(title.intro).contains("أنا في الطريق"), "Complete novel conversation retains both speakers and chosen name")
	check(title.intro._content.find_children("*", "Button", true, false).is_empty(), "No embedded menus appear in the transcript")
	check(not str(title._story).contains("private_lore"), "Author-only secrets stay outside rendered story")
	await story_capture("novel-complete-call")
	await press(title.intro.next_button)
	check(title.profile.data.intro_seen and title.game.session.phase == "investigation", "Story transitions directly to first investigation")
	check(is_instance_valid(title.arrival_intro) and title.arrival_intro.visible, "First crime-scene arrival shows inner-monologue summary")
	check(not title.arrival_intro.next_button.visible, "Arrival summary reveals progressively")
	for step in range(30): title.arrival_intro._process(10.0)
	check(not visible_text(title.arrival_intro).contains("تبويب"), "Case summary and investigation guidance occupy separate panels")
	await press(title.arrival_intro.next_button)
	for step in range(30): title.arrival_intro._process(10.0)
	check(not visible_text(title.arrival_intro).contains("ثلاثة وأربعون"), "Next panel replaces previous summary")
	check(visible_text(title.arrival_intro).contains("المعلومات") and visible_text(title.arrival_intro).contains("لوح التحقيق"), "Board information guidance has its own panel")
	await press(title.arrival_intro.next_button)
	for step in range(30): title.arrival_intro._process(10.0)
	check(visible_text(title.arrival_intro).contains("أجمع الأدلة") and not visible_text(title.arrival_intro).contains("تبويب"), "Evidence collection and questioning have a separate panel")
	check(not visible_text(title.arrival_intro).contains("نادين"), "Summary does not reveal culprit")
	await settle()
	title.arrival_intro._scroll.scroll_vertical = int(title.arrival_intro._scroll.get_v_scroll_bar().max_value)
	await story_capture("arrival-summary")
	await press(title.arrival_intro.next_button)
	check(not is_instance_valid(title.arrival_intro), "Begin investigation dismisses monologue")
	title.game.show_dialogue_log()
	check(visible_text(title.game.modal_body).contains("أين سأجدك"), "Conversation remains accessible in investigation log")
	title.return_to_menu()
	await clear_title()
	await create_title()
	await press(title.menu_buttons["متابعة"])
	check(not is_instance_valid(title.intro) and title.game.session.phase == "investigation", "Continue does not replay watched opening")
	check(not is_instance_valid(title.arrival_intro), "Continue does not repeat first-arrival summary")
	title.return_to_menu()
	title.show_identity()
	title.name_input.text = "ليان"
	title.submit_identity()
	await settle()
	await press(title.intro.skip_button)
	check(title.profile.data.intro_seen and title.game.session.phase == "investigation", "Skip works during animated writing")
	await clear_title()
	for path in [STORY_PROFILE, STORY_SAVE]: DirAccess.remove_absolute(path)
	print("STORY PACING: %s (%d checks, %d failures)" % ["PASS" if failures == 0 else "FAIL", checks, failures])
	quit(0 if failures == 0 else 1)
