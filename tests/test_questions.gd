extends SceneTree
const Session = preload("res://scripts/core/investigation_session.gd")
func _initialize() -> void:
	var s := Session.new()
	assert(s.load_case("res://data/cases/midnight_training.json"))
	assert(s.begin_investigation())
	assert(s.ask_question("arrival").status == "invalid")
	assert(s.select_person("layla"))
	assert(s.ask_question("cup").status == "locked")
	assert(s.ask_question("arrival").status == "answered")
	assert(s.ask_question("arrival").status == "answered")
	assert(s.asked_questions().size() == 1)
	assert(s.collect_evidence("coffee"))
	assert(s.ask_question("cup").status == "answered")
	assert(s.ask_question("missing").status == "invalid")
	assert(s.confront("cup", "phone").status == "invalid")
	assert(s.confront("cup", "coffee").status == "confirmed")
	assert(s.confront("cup", "coffee").status == "duplicate")
	assert(not s.witness_heard())
	assert(s.can_conclude())
	var context := s.dialogue_context("layla", "cup")
	assert(not context.has("truth") and not context.has("conceals") and not context.has("lies"))
	assert(context.allowed_facts.size() == 1)
	assert(s.dialogue_history().size() == 3)
	s.reset()
	assert(s.asked_questions().is_empty() and s.discovered_contradictions().is_empty())
	print("QUESTIONS: PASS")
	quit()
